# Copy to .env.local (gitignored). Never commit real values.

# Meta Model API (primary)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_VISUAL=muse-spark-1.3
META_MODEL_CODE=muse-wonder-1.0

# Baseten (optional secondary provider)
BASETEN_API_KEY=
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_VISUAL=meta-models/muse-spark-open-1026

# Bounds
PROOFPILOT_INFERENCE_TIMEOUT_MS=60000
PROOFPILOT_INFERENCE_MAX_RETRIES=0

# Billable inference is OFF unless explicitly set to 1 with owner authorization.
PROOFPILOT_ALLOW_BILLABLE_CALLS=0

# Sending a recording to the provider is a separate opt-in (also needs billable calls ON). Off by default.
PROOFPILOT_ALLOW_VIDEO_UPLOAD=0

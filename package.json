{
  "name": "proofpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ProofPilot AI: reproduce a UI defect, propose a patch, and independently prove whether it is fixed.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fixture:serve": "node fixtures/sample-store/server.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:security": "node --test \"tests/security/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "test": "pnpm test:unit && pnpm test:security",
    "test:e2e:f01": "playwright test -c verifier/playwright.config.ts",
    "f01:baseline": "node scripts/f01-baseline.ts",
    "inference:status": "node --env-file-if-exists=.env.local scripts/inference-status.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
